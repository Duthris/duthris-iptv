# Copy to .env.local and fill in. .env.local is gitignored.

# Optional TMDB access token, used to fill in artwork, descriptions and cast
# for titles the playlist provider does not describe. Without it the app falls
# back to provider data and the feature stays off. A token can also be entered
# from the settings screen instead.
#
# Free, from themoviedb.org > Settings > API. Either the v4 read access token
# or the older v3 key works.
#
# Note: this value is inlined into the client bundle at build time and can be
# read out of a packaged build.
NEXT_PUBLIC_TMDB_TOKEN=

# Optional OpenSubtitles API key, used to search and download subtitles for
# titles that ship without them. Without it the search button is hidden.
#
# Free, from opensubtitles.com > API Consumers. Keep "allow anonymous
# downloads" enabled, otherwise the download endpoint requires each user to
# log in. The daily download allowance is per key, not per user.
NEXT_PUBLIC_OPENSUBTITLES_KEY=
