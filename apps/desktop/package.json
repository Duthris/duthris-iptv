{
  "name": "@iptv/desktop",
  "version": "1.2.0",
  "private": true,
  "description": "Duthris IPTV desktop shell",
  "author": "Duthris",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json && pnpm run build:preload",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.js",
    "dev": "pnpm run build:main && cross-env IPTV_DEV_SERVER=http://localhost:3000 electron .",
    "package": "pnpm run build:main && electron-builder --win --publish never",
    "typecheck": "tsc -p tsconfig.main.json --noEmit",
    "clean": "rimraf dist release .turbo"
  },
  "devDependencies": {
    "@iptv/config": "workspace:*",
    "@types/node": "^20.14.10",
    "cross-env": "^7.0.3",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "license": "MIT"
}
